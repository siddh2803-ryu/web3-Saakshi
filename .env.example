# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
WEBHOOK_SECRET=replace_with_a_secure_random_string_for_webhooks
CRON_SECRET=replace_with_a_secure_cron_secret
SANDBOX_ADMIN_SECRET=chirp_admin_secret_key_demo
CAPTURE_ENABLED=true
DAILY_FREE_CAPTURES=5

# TinyFish
TINYFISH_API_KEY=
TINYFISH_MODE=fixture              # live | fixture (dev only)
TINYFISH_AGENT_BETA=false       # true only if agent_config.max_steps / mode are enabled for the account
TINYFISH_CAPTURE_CONFIG=false   # true only if capture_config (html, recording) is enabled

# Firebase
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_SERVICE_ACCOUNT_B64=

# Evidence crypto
MASTER_KEY_B64=                 # 32 random bytes, base64 (e.g. openssl rand -base64 32)
UID_HASH_SALT=saakshi_salt_change_me_in_production

# IPFS
PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs

# Chain
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
ANCHOR_PRIVATE_KEY=
