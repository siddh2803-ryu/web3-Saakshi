rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // users/{uid}: Owner-only read, NO client writes (PRD 9.4)
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // cases/{caseId}: Owner-only read, NO client writes (PRD 9.4)
    match /cases/{caseId} {
      allow read: if isOwner(resource.data.ownerUid);
      allow write: if false;
    }

    // captures/{captureId}: Owner-only read, NO client writes (PRD 9.4)
    match /captures/{captureId} {
      allow read: if isOwner(resource.data.ownerUid);
      allow write: if false;

      match /artifacts/{artifactId} {
        allow read: if isOwner(get(/databases/$(database)/documents/captures/$(captureId)).data.ownerUid);
        allow write: if false;
      }
    }

    // watches/{watchId}: Owner-only read, NO client writes (PRD 9.4)
    match /watches/{watchId} {
      allow read: if isOwner(resource.data.ownerUid);
      allow write: if false;

      match /events/{eventId} {
        allow read: if isOwner(get(/databases/$(database)/documents/watches/$(watchId)).data.ownerUid);
        allow write: if false;
      }
    }

    // custody/{captureId}: Owner-only read, NO client writes (PRD 9.4)
    match /custody/{captureId} {
      allow read: if isOwner(get(/databases/$(database)/documents/captures/$(captureId)).data.ownerUid);
      allow write: if false;

      match /events/{eventId} {
        allow read: if isOwner(get(/databases/$(database)/documents/captures/$(captureId)).data.ownerUid);
        allow write: if false;
      }
    }

    // publicProofs/{sha256}: Public read-only, NO client writes (PRD 9.4)
    match /publicProofs/{sha256} {
      allow read: if true;
      allow write: if false;
    }

    // shares/{shareId}: No client access whatsoever (PRD 9.4, Server Admin SDK only)
    match /shares/{shareId} {
      allow read: if false;
      allow write: if false;
    }

    // rate_limits/{doc}: Server Admin SDK only, no client access
    match /rate_limits/{doc} {
      allow read: if false;
      allow write: if false;
    }

    // Catch-all: Deny all other client reads and writes
    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
