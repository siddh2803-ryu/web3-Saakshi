{
  "name": "saakshi-monorepo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "apps/web",
    "contracts"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web",
    "start": "npm run start --workspace=apps/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run contracts:compile && npm run typecheck --workspace=apps/web && npm run typecheck --workspace=contracts",
    "test": "npm run test:web && npm run test:contracts",
    "test:contracts": "npm run test --workspace=contracts",
    "test:web": "npm run test --workspace=apps/web",
    "contracts:compile": "npm run compile --workspace=contracts",
    "contracts:test": "npm run test --workspace=contracts",
    "check:bundle": "npx ts-node -r tsconfig-paths/register scripts/check-bundle.ts",
    "pinata:cleanup": "npx ts-node -r tsconfig-paths/register scripts/pinata-cleanup.ts",
    "monitor:cleanup": "npx ts-node -r tsconfig-paths/register scripts/monitor-cleanup.ts",
    "new:wallet": "npx ts-node -r tsconfig-paths/register scripts/new-wallet.ts",
    "verify:bundle": "npx ts-node -r tsconfig-paths/register scripts/verify.ts",
    "check:channels": "npx ts-node -r tsconfig-paths/register scripts/check-channels.ts",
    "validate:ai": "npx ts-node -r tsconfig-paths/register scripts/validate-ai-captures.ts",
    "chain:local": "bash scripts/chain-local.sh"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
