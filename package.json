{
  "name": "saakshi-monorepo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "apps/web",
    "contracts"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web",
    "start": "npm run start --workspace=apps/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run contracts:compile && npm run typecheck --workspace=apps/web && npm run typecheck --workspace=contracts",
    "test": "npm run test:web && npm run test:contracts",
    "test:contracts": "npm run test --workspace=contracts",
    "test:web": "npm run test --workspace=apps/web",
    "contracts:compile": "npm run compile --workspace=contracts",
    "contracts:test": "npm run test --workspace=contracts"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
