    "@types/mocha": "^10.0.7",
    "@types/node": "^20.14.9",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.1",
    "hardhat": "^2.22.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
